# Google OAuth client id - the same value in both, one is exposed to the browser
GOOGLE_CLIENT_ID=xxxxx.apps.googleusercontent.com
NEXT_PUBLIC_GOOGLE_CLIENT_ID=xxxxx.apps.googleusercontent.com

# Random string, 32+ chars. Generate with: openssl rand -base64 32
SESSION_SECRET=replace-me-with-32-plus-random-characters

# Who gets in
ALLOWED_DOMAINS=interviewkickstart.com
ALLOWED_EMAILS=sdizzthebest@gmail.com

# Optional: sign-in log
SUPABASE_URL=https://nalyeofonirmbkvblpyh.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Your deployed URL, used by the logout redirect
NEXT_PUBLIC_SITE_URL=https://your-deck.vercel.app
